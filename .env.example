# 大模型配置。不填写 API Key 时默认使用离线 Mock 大模型。
BRAIN_LLM_PROVIDER=mock
# BRAIN_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# BRAIN_LLM_API_KEY=sk-你的Key
# BRAIN_LLM_MODEL=qwen-plus
BRAIN_LLM_TIMEOUT=30
BRAIN_LLM_MAX_RETRIES=2
BRAIN_LLM_TEMPERATURE=0.0
BRAIN_LLM_MAX_TOKENS=128

# 本地 Ollama 示例
# BRAIN_LLM_PROVIDER=openai
# BRAIN_LLM_BASE_URL=http://127.0.0.1:11434/v1
# BRAIN_LLM_MODEL=qwen2.5:7b
# BRAIN_LLM_API_KEY=ollama

# 通信方式: mock, tcp, serial
BRAIN_TRANSPORT=mock
BRAIN_TCP_HOST=127.0.0.1
BRAIN_TCP_PORT=9000
BRAIN_SERIAL_PORT=COM3
BRAIN_BAUDRATE=115200
BRAIN_CONNECT_TIMEOUT=3
BRAIN_REPORT_TIMEOUT=5

# 日志
BRAIN_LOG_FILE=
BRAIN_VERBOSE=0